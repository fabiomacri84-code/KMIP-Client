FROM docker.io/library/python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends binutils libegl1 libopengl0 libgl1 libxkbcommon0 libxcb-cursor0 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY requirements*.txt /tmp/deps/
RUN pip install --no-cache-dir -r /tmp/deps/requirements-build.txt
RUN apt-get update && apt-get install -y --no-install-recommends libnss3 libasound2 libdbus-1-3 libfontconfig1 libfreetype6 libglib2.0-0 libxcomposite1 libxdamage1 libxrandr2 libxtst6 libxcb-icccm4 libxcb-keysyms1 libxcb-shape0 libxcb-xkb1 libxkbcommon-x11-0 libxrender1 libx11-xcb1 libxss1 libbrotli1 libgssapi-krb5-2 libsm6 libice6 libxcursor1 libxi6 && rm -rf /var/lib/apt/lists/*
CMD ["python", "packaging/build.py"]
